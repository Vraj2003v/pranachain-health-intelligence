{
  "name": "PranaPulse",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "pip install -r requirements.txt && (cd web && npm ci && npm run build) && python -m pytest -q",
  "postAttachCommand": "python -m uvicorn api.main:app --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "PranaPulse app", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
