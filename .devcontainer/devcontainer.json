{
  "name": "PranaPulse",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "pip install -r requirements.txt && python -m pytest -q",
  "postAttachCommand": "streamlit run app.py --server.port 8501 --server.headless true",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "PranaPulse app", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
